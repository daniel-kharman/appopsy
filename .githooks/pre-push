#!/bin/sh
# appopsy pre-push: before anything leaves this machine, run both third-party
# checks (see CLAUDE.md) on EVERY commit being pushed, not just the tip, because
# history is what becomes public. Needs your app list outside the repo at
# ~/.config/appopsy/my-apps.txt (or $APPOPSY_THIRD_PARTY_LIST). Fails closed.
# Install once with:  git config core.hooksPath .githooks
set -eu
repo=$(git rev-parse --show-toplevel)
appopsy="$repo/.venv/bin/appopsy"
list="${APPOPSY_THIRD_PARTY_LIST:-$HOME/.config/appopsy/my-apps.txt}"
if [ ! -x "$appopsy" ]; then
    echo "pre-push: $appopsy not found; run 'uv sync' first." >&2
    exit 1
fi
broken() {  # $1: the command that couldn't run, $2: its output
    echo "pre-push: the Python environment in $repo/.venv is broken; the checks can't run." >&2
    echo "  $1 failed with:" >&2
    printf '%s\n' "$2" | sed 's/^/    /' >&2
    echo "  Fix it with 'uv sync' (or remove .venv and run 'uv sync'). Nothing was pushed." >&2
    exit 1
}
out=$("$repo/.venv/bin/python" -c "import appopsy" 2>&1) || broken "$repo/.venv/bin/python" "$out"
out=$("$appopsy" --version 2>&1) || broken "$appopsy --version" "$out"
if [ ! -f "$list" ]; then
    echo "pre-push: no app list at $list, so the third-party checks can't run." >&2
    echo "Create it from a case folder: cp cases/<case>/raw/pm-list-packages-3p.txt $list" >&2
    exit 1
fi
zero=0000000000000000000000000000000000000000
tmp=$(mktemp -d "${TMPDIR:-/tmp}/appopsy-pre-push.XXXXXX")
trap 'rm -rf "$tmp"' EXIT INT TERM
# Your non-allowlisted app names, for checking commit messages.
"$repo/.venv/bin/python" - "$list" >"$tmp/names" <<'PY'
import sys
from pathlib import Path
from appopsy.redact_packages import DEFAULT_ALLOWLIST, load_third_party_list
allowed = {a.name for a in DEFAULT_ALLOWLIST}
print("\n".join(sorted(load_third_party_list(Path(sys.argv[1])) - allowed)))
PY
status=0
check_result() {  # $1 exit code, $2 output, $3 check name, $4 message for a finding
    if [ "$1" -eq 0 ]; then
        return
    fi
    if [ "$1" -eq 1 ] && ! printf '%s' "$2" | grep -q "Traceback (most recent call last)"; then
        echo "$4" >&2
        status=1
    else
        broken "the $3 (exit $1)" "$2"
    fi
}
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue  # deleting a ref: nothing to check
    if [ "$remote_sha" = "$zero" ]; then
        commits=$(git rev-list "$local_sha" --not --remotes)
    else
        commits=$(git rev-list "$remote_sha..$local_sha")
    fi
    for c in $commits; do
        dir="$tmp/$c"
        mkdir -p "$dir"
        git archive "$c" | tar -x -C "$dir"
        short=$(git rev-parse --short "$c")
        # Exit 1 with a report is a finding; anything else (or a traceback) means the
        # checker itself didn't run, which is reported as such, not as a finding.
        if [ -d "$dir/tests/fixtures" ]; then
            code=0; out=$("$appopsy" redact-fixture --check --third-party-list "$list" "$dir/tests/fixtures" 2>&1) || code=$?
            check_result "$code" "$out" "fixture check" \
                "pre-push: $short: fixture check failed (run it on tests/fixtures to see why)"
        fi
        code=0; out=$("$appopsy" redact-fixture --check --apps-only --third-party-list "$list" "$dir" 2>&1) || code=$?
        check_result "$code" "$out" "apps-only check" "pre-push: $short: one of your apps is named in the tree"
        # The Wikidata names file is exempt from the apps check only because it is
        # the whole public set: any commit that changes it must verify against
        # Wikidata (every row there, at least 95% of a fresh generation), or the
        # push is refused, offline included.
        names_file="appopsy/report/app_names.tsv"
        if git diff-tree --root --no-commit-id --name-only -r "$c" | grep -qxF "$names_file" \
            && [ -f "$dir/$names_file" ]; then
            code=0
            out=$("$repo/.venv/bin/python" "$dir/scripts/update_app_names.py" --verify "$dir/$names_file" 2>&1) || code=$?
            if [ "$code" -ne 0 ]; then
                echo "pre-push: $short: the app names file didn't verify against Wikidata (exit $code):" >&2
                printf '%s\n' "$out" | sed 's/^/    /' >&2
                status=1
            fi
        fi
        if [ -s "$tmp/names" ] && git log -1 --format=%B "$c" | grep -qFf "$tmp/names"; then
            echo "pre-push: $short: one of your apps is named in the commit message" >&2; status=1
        fi
        rm -rf "$dir"
    done
done
[ "$status" -eq 0 ] && echo "pre-push: both third-party checks passed for every commit" >&2
exit "$status"
