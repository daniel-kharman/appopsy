{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(git merge-base *)",
      "Bash(git branch --show-current)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh api *)"
    ],
    "ask": [
      "Edit(**/.claude/settings.json)",
      "Write(**/.claude/settings.json)",
      "Edit(**/.claude/hooks/**)",
      "Write(**/.claude/hooks/**)",
      "Edit(**/.claude/agents/**)",
      "Write(**/.claude/agents/**)",
      "Edit(**/.githooks/**)",
      "Write(**/.githooks/**)",
      "Edit(**/.github/**)",
      "Write(**/.github/**)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(gh label *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(gh ruleset *)"
    ],
    "deny": [
      "Bash(adb *)",
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push --no-verify *)",
      "Bash(git push * --no-verify *)",
      "Bash(git push * --no-verify)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify *)",
      "Bash(git commit * --no-verify)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/command_guard.py\""
          }
        ]
      }
    ]
  }
}
